// Prisma schema — corrected & normalized
// - Model names: PascalCase (DB table = snake_case via @@map)
// - Field names: camelCase (DB column = snake_case via @map)
// - Enums: PascalCase
// - All relation mismatches fixed
// - Status fields converted to enums
// - Timestamps added to Orders

generator client {
  provider = "prisma-client"
  output   = "../source/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  KITCHEN_STAFF
  KITCHEN_CHEF
  DELIVERY_DRIVER
  WAITER
  MANAGER
  DEVELOPER
  MARKETING
  HR
  FINANCE
  CONTROLLER
}

enum paymentMethods {
  CASH
  MONETBIL
  CARD
  PAYPAL
  PAYROLL_DEDUCTION
}

enum BenefitType {
  percentage_discount
  fixed_amount_discount
  free_delivery
  free_product
}

enum ConditionType {
  promo_code
  shipping_address
  specific_product
  specific_menu
  minimum_order_amount
  first_time_customers
  subcategory
  category
  product_quantity
}

enum Gender {
  Male
  Female
  Other
}

enum CombinationMode {
  AND
  OR
  ANY
}

enum OrderItemStatus {
  pending
  preparing
  ready
  delivered
  cancelled
}

enum orderstatus {
  pending
  kitchen
  confirmed
  preparing
  ready
  ready_for_delivery
  out_for_delivery
  delivered
  cancelled
}

enum DeliveryStatus {
  pending
  assigned
  in_transit
  delivered
  failed
}

enum ReservationStatus {
  pending
  confirmed
  seated
  completed
  cancelled
}

enum tokenType {
  refreshToken
  verificationToken
  passwordresetToken
  sessionToken
}

enum preferenceName {
  preferredPaymentMethod
  preferredDeliveryAddress
  preferredLanguage
  preferredCurrency
  favoriteCategory
  favoriteSubcategory
  favoriteProduct
  favoriteMenu
  notificationPreferences
  marketingOptIn
}

// ─── Customer domain ──────────────────────────────────────────────────────────

model Customers {
  phone           String            @id
  firstName       String            @map("first_name")
  lastName        String?           @map("last_name")
  email           String?           @unique
  gender          Gender?
  dateOfBirth     DateTime?         @map("date_of_birth")
  verified        Boolean           @default(false)
  accounts        Accounts?
  orders          Orders[]
  reservations    Reservations[]
  promotions      PromotionUsage[]
  addresses       Address[]
  favorites       Favorites[]
  reviews         Reviews[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  tokens          Token[]
  userPreferences UserPreferences[]

  @@map("customers")
}

model UserPreferences {
  id            String         @id @default(uuid())
  customer      Customers?     @relation(fields: [customerPhone], references: [phone])
  customerPhone String?        @map("customer_phone")
  employee      Employees?     @relation(fields: [employeeEmail], references: [email])
  employeeEmail String?        @map("employee_email")
  name          preferenceName
  value         String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([customerPhone, name]) // one preference of each type per customer
  @@index([customerPhone])
  @@map("user_preferences")
}

model Token {
  token         String     @id
  customer      Customers? @relation(fields: [customerPhone], references: [phone])
  customerPhone String?    @map("customer_phone")
  employee      Employees? @relation(fields: [employeeEmail], references: [email])
  employeeEmail String?    @map("employee_email")
  employeeRole  Role?      @map("employee_role")
  type          tokenType
  revoked       Boolean    @default(false)
  expiresAt     DateTime   @map("expires_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@index([employeeEmail])
  @@map("tokens")
}

model Accounts {
  customerPhone String    @id @unique @map("customer_phone")
  balance       Float     @default(0)
  password      String
  customer      Customers @relation(fields: [customerPhone], references: [phone])
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("accounts")
}

model Address {
  id                  String            @id @default(uuid())
  customer            Customers         @relation(fields: [customerPhone], references: [phone])
  customerPhone       String            @map("customer_phone")
  shippingAddress     ShippingAddresses @relation(fields: [shippingAddressName], references: [name])
  shippingAddressName String            @map("shipping_address_name")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@map("addresses")
}

model Favorites {
  id            String    @id @default(uuid())
  customer      Customers @relation(fields: [customerPhone], references: [phone])
  customerPhone String    @map("customer_phone")
  product       Products  @relation(fields: [productId], references: [id])
  productId     String    @map("product_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@index([productId])
  @@map("favorites")
}

model Reviews {
  id            String    @id @default(uuid())
  customer      Customers @relation(fields: [customerPhone], references: [phone])
  customerPhone String    @map("customer_phone")
  product       Products  @relation(fields: [productId], references: [id])
  productId     String    @map("product_id")
  rating        Int
  comment       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@index([productId])
  @@map("reviews")
}

// ─── Employee & branch domain ─────────────────────────────────────────────────

model Employees {
  email           String            @id
  firstName       String            @map("first_name")
  lastName        String?           @map("last_name")
  phone           String            @unique
  password        String
  role            Role
  branch          Branches?         @relation("BranchEmployees", fields: [branchId], references: [id])
  branchId        String?           @map("branch_id")
  managedBranch   Branches?         @relation("BranchManager")
  verified        Boolean           @default(false)
  stationSessions StationSessions[]
  deliveries      Deliveries[]
  cashierOrders   Orders[]          @relation("CashierOrders")
  employeeOrders  Orders[]          @relation("EmployeeOrders")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  tokens          Token[]
  userPreferences UserPreferences[]

  @@index([branchId])
  @@map("employees")
}

model Branches {
  id                String              @id @default(uuid())
  name              String
  region            String
  city              String
  neighborhood      String
  manager           Employees?          @relation("BranchManager", fields: [managerEmail], references: [email])
  managerEmail      String?             @unique @map("manager_email")
  employees         Employees[]         @relation("BranchEmployees")
  shippingAddresses ShippingAddresses[]
  stations          Stations[]
  orders            Orders[]
  reservations      Reservations[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("branches")
}

// ─── Catalog domain ───────────────────────────────────────────────────────────

model Category {
  // make the name of categories as id
  id            String        @id @default(uuid())
  name          String
  description   String
  imageUrl      String?       @map("image_url")
  imagePublicId String?       @map("image_public_id")
  products      Products[]
  subcategories SubCategory[]
  menus         Menu[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("categories")
}

model SubCategory {
  id            String     @id @default(uuid())
  name          String
  description   String
  imageUrl      String?    @map("image_url")
  imagePublicId String?    @map("image_public_id")
  categoryId    String     @map("category_id")
  category      Category   @relation(fields: [categoryId], references: [id])
  products      Products[]
  menus         Menu[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("sub_categories")
}

model Products {
  id              String            @id @default(uuid())
  name            String
  description     String?
  category        Category          @relation(fields: [categoryId], references: [id])
  categoryId      String            @map("category_id")
  subCategory     SubCategory?      @relation(fields: [subCategoryId], references: [id])
  subCategoryId   String?           @map("sub_category_id")
  station         Stations?         @relation(fields: [stationId], references: [id])
  stationId       String?           @map("station_id")
  price           Float
  imageUrl        String?           @map("image_url")
  imagePublicId   String?           @map("image_public_id")
  popularity      Int?
  preparationTime Int?              @map("preparation_time")
  variants        ProductVariants[]
  menuItems       MenuItems[]
  orderItems      OrderItems[]
  favorites       Favorites[]
  reviews         Reviews[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([stationId])
  @@map("products")
}

model Menu {
  id              String       @id @default(uuid())
  name            String
  description     String
  price           Float
  category        Category     @relation(fields: [categoryId], references: [id])
  categoryId      String       @map("category_id")
  subcategory     SubCategory  @relation(fields: [subCategoryId], references: [id])
  subCategoryId   String       @map("sub_category_id")
  imageUrl        String       @map("image_url")
  imagePublicId   String       @map("image_public_id")
  preparationTime Int?         @map("preparation_time")
  items           MenuItems[]
  orderItems      OrderItems[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([subCategoryId])
  @@map("menus")
}

// Relation field is optional: set productId to String? if you need unlinked variants
model ProductVariants {
  id        String   @id @default(uuid())
  name      String
  price     Float
  product   Products @relation(fields: [productId], references: [id])
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

model MenuItems {
  id        String   @id @default(uuid())
  menu      Menu     @relation(fields: [menuId], references: [id])
  menuId    String   @map("menu_id")
  product   Products @relation(fields: [productId], references: [id])
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([menuId])
  @@index([productId])
  @@map("menu_items")
}

// ─── Kitchen domain ───────────────────────────────────────────────────────────

model Stations {
  id              String            @id @default(uuid())
  name            String
  description     String
  products        Products[]
  branch          Branches          @relation(fields: [branchId], references: [id])
  branchId        String            @map("branch_id")
  stationSessions StationSessions[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("stations")
}

// Branch context is inherited via station → branch; no direct branchId needed here.
model StationSessions {
  id                String    @id @default(uuid())
  station           Stations  @relation(fields: [stationId], references: [id])
  stationId         String    @map("station_id")
  kitchenStaff      Employees @relation(fields: [kitchenStaffEmail], references: [email])
  kitchenStaffEmail String    @map("kitchen_staff_email")
  startTime         DateTime  @map("start_time")
  endTime           DateTime  @map("end_time")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([stationId])
  @@index([kitchenStaffEmail])
  @@map("station_sessions")
}

// ─── Delivery domain ──────────────────────────────────────────────────────────

model ShippingAddresses {
  name         String       @id
  region       String
  city         String
  neighborhood String
  deliveryFee  Float        @map("delivery_fee")
  deliveryTime Int          @map("delivery_time")
  branch       Branches     @relation(fields: [branchId], references: [id])
  branchId     String       @map("branch_id")
  deliveries   Deliveries[]
  addresses    Address[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("shipping_addresses")
}

// ─── Order domain ─────────────────────────────────────────────────────────────
model Orders {
  number        String           @id @default(uuid()) @map("number")
  branch        Branches         @relation(fields: [branchId], references: [id])
  branchId      String           @map("branch_id")
  cashier       Employees?       @relation(name: "CashierOrders", fields: [cashierEmail], references: [email])
  cashierEmail  String?          @map("cashier_email")
  customer      Customers        @relation(fields: [customerPhone], references: [phone])
  customerPhone String           @map("customer_phone")
  employee      Employees?       @relation(name: "EmployeeOrders", fields: [employeeEmail], references: [email])
  employeeEmail String?          @map("employee_email")
  discount      Float            @default(0)
  subtotal      Float            @map("subtotal")
  status        OrderStatus?
  total         Float            @map("total")
  items         OrderItems[]
  deliveries    Deliveries[]
  pickupOrders  PickupOrders[]
  dineInOrders  DineInOrders[]
  Payments      Payments[]
  promotions    PromotionUsage[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@index([cashierEmail])
  @@index([branchId])
  @@index([employeeEmail])
  @@map("orders")
}

model OrderItems {
  id               String          @id @default(uuid())
  order            Orders          @relation(fields: [orderNumber], references: [number])
  orderNumber      String          @map("order_number")
  product          Products?       @relation(fields: [productId], references: [id])
  productId        String?         @map("product_id")
  menu             Menu?           @relation(fields: [menuId], references: [id])
  menuId           String?         @map("menu_id")
  quantity         Int
  price            Float
  status           OrderItemStatus
  estimatedReadyAt DateTime        @map("estimated_ready_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@map("order_items")
}

model Deliveries {
  id                    String            @id @default(uuid())
  order                 Orders            @relation(fields: [orderNumber], references: [number])
  orderNumber           String            @map("order_number")
  driver                Employees         @relation(fields: [driverEmail], references: [email])
  driverEmail           String            @map("driver_email")
  status                DeliveryStatus
  estimatedDeliveryTime DateTime          @map("estimated_delivery_time")
  actualDeliveryTime    DateTime?         @map("actual_delivery_time")
  shippingAddress       ShippingAddresses @relation(fields: [shippingAddressName], references: [name])
  shippingAddressName   String            @map("shipping_address_name")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@map("deliveries")
}

model PickupOrders {
  id          String   @id @default(uuid())
  order       Orders   @relation(fields: [orderNumber], references: [number])
  orderNumber String   @map("order_number")
  pickupTime  DateTime @map("pickup_time")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@map("pickup_orders")
}

model DineInOrders {
  id          String   @id @default(uuid())
  order       Orders   @relation(fields: [orderNumber], references: [number])
  orderNumber String   @map("order_number")
  tableNumber Int      @map("table_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@map("dine_in_orders")
}

model OrderStatus {
  id          String      @id @default(uuid())
  order       Orders      @relation(fields: [orderNumber], references: [number])
  orderNumber String      @unique @map("order_number")
  value       orderstatus
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("order_statuses")
}

// ─── Payment domain ───────────────────────────────────────────────────────────

model Payments {
  id                   String                @id @default(uuid())
  order                Orders                @relation(fields: [orderNumber], references: [number])
  // Removed @unique: an order may have multiple payment attempts
  orderNumber          String                @map("order_number")
  amount               Float
  method               paymentMethods
  provider             String                @default("MonetBill")
  status               String
  monetbillTransaction MonetbillTransaction?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([orderNumber])
  @@map("order_payments")
}

model MonetbillTransaction {
  id                    String   @id @default(uuid())
  orderPayment          Payments @relation(fields: [orderPaymentId], references: [id])
  orderPaymentId        String   @unique @map("order_payment_id")
  reference             String
  transactionId         String   @map("transaction_id")
  transactionUuid       String   @map("transaction_uuid")
  amount                Float
  fee                   Float
  currency              String
  provider              String
  status                String
  customerName          String   @map("customer_name")
  customerNumber        String   @map("customer_number")
  message               String?
  mccmc                 String?
  operator              String?
  operatorCode          String?  @map("operator_code")
  operatorTransactionId String?  @map("operator_transaction_id")
  sign                  String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("monetbill_transactions")
}

// ─── Reservation domain ───────────────────────────────────────────────────────

model Reservations {
  id              String            @id @default(uuid())
  customer        Customers         @relation(fields: [customerPhone], references: [phone])
  customerPhone   String            @map("customer_phone")
  reservationDate DateTime          @map("reservation_date")
  reservationTime DateTime          @map("reservation_time")
  comments        String?
  branch          Branches          @relation(fields: [branchId], references: [id])
  branchId        String            @map("branch_id")
  numberOfPeople  Int               @map("number_of_people")
  status          ReservationStatus
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([customerPhone])
  @@index([branchId])
  @@map("reservations")
}

// ─── Promotion domain ─────────────────────────────────────────────────────────

model Promotion {
  id                  String               @id @default(uuid())
  name                String               @unique
  description         String
  startDate           DateTime             @map("start_date")
  endDate             DateTime             @map("end_date")
  isActive            Boolean              @default(true) @map("is_active")
  maxUses             Int                  @map("max_uses")
  usedCount           Int                  @default(0) @map("used_count")
  combinationMode     CombinationMode      @map("combination_mode")
  promotionConditions PromotionCondition[]
  promotionBenefits   PromotionBenefit[]
  promotionUsages     PromotionUsage[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("promotions")
}

model PromotionCondition {
  id          String        @id @default(uuid())
  promotion   Promotion     @relation(fields: [promotionId], references: [id])
  promotionId String        @map("promotion_id")
  type        ConditionType
  value       Json
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([promotionId])
  @@map("promotion_conditions")
}

model PromotionBenefit {
  id          String      @id @default(uuid())
  promotion   Promotion   @relation(fields: [promotionId], references: [id])
  promotionId String      @map("promotion_id")
  type        BenefitType
  value       Json
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([promotionId])
  @@map("promotion_benefits")
}

model PromotionUsage {
  id            String    @id @default(uuid())
  promotion     Promotion @relation(fields: [promotionId], references: [id])
  promotionId   String    @map("promotion_id")
  order         Orders    @relation(fields: [orderNumber], references: [number])
  orderNumber   String    @map("order_number")
  customer      Customers @relation(fields: [customerPhone], references: [phone])
  customerPhone String    @map("customer_phone")
  usedAt        DateTime  @default(now()) @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([promotionId])
  @@index([orderNumber])
  @@index([customerPhone])
  @@map("promotion_usages")
}
