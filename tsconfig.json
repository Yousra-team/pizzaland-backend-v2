{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "outDir": "./dist",

  },
  "include": ["source/**/*" ,"prisma.config.ts" ],
  "exclude": ["node_modules", "dist" ,"mocks"]
}

