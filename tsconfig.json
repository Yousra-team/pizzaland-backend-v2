{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    


    "rootDir": "./source",
    "outDir": "./dist"
  },
  "include": ["source/**/*"],
  "exclude": ["node_modules", "dist", "mocks"]
}